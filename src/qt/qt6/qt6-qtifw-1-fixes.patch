From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Ju=C5=99ena?= <jurenatomas@gmail.com>
Date: Sun, 8 Nov 2026 11:07:02 +0100
Subject: [PATCH 1/6] fixes for cross building

Allow cross compilation and use lowercase Windows header names, since
the MinGW headers are lowercase and Linux filesystems are case-sensitive.

diff --git a/installerfw.pro b/installerfw.pro
index 1111111..2222222 100644
--- a/installerfw.pro
+++ b/installerfw.pro
@@ -5,8 +5,6 @@ TEMPLATE = subdirs
 SUBDIRS += src tools
 tools.depends = src
 
-requires(!cross_compile)
-
 include (installerfw.pri)
 include (doc/doc.pri)
 
diff --git a/src/libs/installer/createshortcutoperation.cpp b/src/libs/installer/createshortcutoperation.cpp
index 1111111..2222222 100644
--- a/src/libs/installer/createshortcutoperation.cpp
+++ b/src/libs/installer/createshortcutoperation.cpp
@@ -25,7 +25,7 @@ using namespace QInstaller;
 #ifdef Q_OS_WIN
 #include <qt_windows.h>
 #include <shlobj.h>
-#include <Intshcut.h>
+#include <intshcut.h>
 
 #ifndef PIDLIST_ABSOLUTE
 typedef ITEMIDLIST *PIDLIST_ABSOLUTE;
diff --git a/src/libs/installer/libarchivearchive.h b/src/libs/installer/libarchivearchive.h
index 1111111..2222222 100644
--- a/src/libs/installer/libarchivearchive.h
+++ b/src/libs/installer/libarchivearchive.h
@@ -15,7 +15,7 @@
 #include <QThread>
 
 #if defined(_MSC_VER)
-#include <BaseTsd.h>
+#include <basetsd.h>
 typedef SSIZE_T ssize_t;
 #endif
 

