From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Ju=C5=99ena?= <jurenatomas@gmail.com>
Date: Sun, 8 Nov 2026 11:09:47 +0100
Subject: [PATCH 4/6] use host tools when cross compiling

rcc and lrelease run at build time, so take them from the host Qt
instead of the target Qt.

diff --git a/installerfw.pri b/installerfw.pri
index 1111111..2222222 100644
--- a/installerfw.pri
+++ b/installerfw.pri
@@ -79,13 +79,13 @@ isEmpty(IFW_LIB_PATH) {
     IFW_LIB_PATH = $$IFW_BUILD_TREE/lib
 }
 
-RCC = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_BINS]/rcc))
-LRELEASE = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_BINS]/lrelease))
-LUPDATE = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_BINS]/lupdate))
-LCONVERT = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_BINS]/lconvert))
-QMAKE_BINARY = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_BINS]/qmake))
+RCC = $$toNativeSeparators($$cleanPath($$[QT_HOST_BINS]/rcc))
+LRELEASE = $$toNativeSeparators($$cleanPath($$[QT_HOST_BINS]/lrelease))
+LUPDATE = $$toNativeSeparators($$cleanPath($$[QT_HOST_BINS]/lupdate))
+LCONVERT = $$toNativeSeparators($$cleanPath($$[QT_HOST_BINS]/lconvert))
+QMAKE_BINARY = $$toNativeSeparators($$cleanPath($$[QT_HOST_BINS]/qmake))
 
-win32 {
+equals(QMAKE_HOST.os, Windows) {
     RCC = $${RCC}.exe
     LRELEASE = $${LRELEASE}.exe
     LUPDATE = $${LUPDATE}.exe
@@ -96,7 +96,7 @@ win32 {
 #6.6.0 rcc has been moved to libexec in linux/mac and the RCC variable no longer
 #points to correct location
 !exists($$RCC) {
-    RCC = $$toNativeSeparators($$cleanPath($$[QT_INSTALL_LIBEXECS]/rcc))
+    RCC = $$toNativeSeparators($$cleanPath($$[QT_HOST_LIBEXECS]/rcc))
 }
 !exists($$RCC) {
     warning("Resource compiler '$$RCC' not found.")

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Ju=C5=99ena?= <jurenatomas@gmail.com>
Date: Sun, 8 Nov 2026 17:54:38 +0100
Subject: [PATCH 5/6] link Core5Compat with a shared Qt6 too

libinstaller is a static library that uses QTextCodec, but only static
Qt builds added core5compat to the apps linking it.

diff --git a/installerfw.pri b/installerfw.pri
index 1111111..2222222 100644
--- a/installerfw.pri
+++ b/installerfw.pri
@@ -134,8 +134,10 @@ QT += uitools core-private
 CONFIG(static, static|shared) {
     win32:lessThan(QT_MAJOR_VERSION, 6):QT += winextras
     QT += concurrent network qml xml
-    greaterThan(QT_MAJOR_VERSION, 5):QT += core5compat
 }
+# libinstaller is always a static library and uses Core5Compat, so every
+# app linking it needs the module, even when Qt itself is shared
+greaterThan(QT_MAJOR_VERSION, 5):QT += core5compat
 CONFIG += depend_includepath no_private_qt_headers_warning
 versionAtLeast(QT_MAJOR_VERSION, 6) {
     CONFIG+=c++17

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Ju=C5=99ena?= <jurenatomas@gmail.com>
Date: Sun, 8 Nov 2026 18:07:48 +0100
Subject: [PATCH 6/6] libarchive: don't redefine MinGW's mode_t, pid_t and
 ssize_t

The Windows config.h is written for MSVC; MinGW's sys/types.h already
typedefs these.

diff --git a/src/libs/3rdparty/libarchive/config/win/config.h b/src/libs/3rdparty/libarchive/config/win/config.h
index 1111111..2222222 100644
--- a/src/libs/3rdparty/libarchive/config/win/config.h
+++ b/src/libs/3rdparty/libarchive/config/win/config.h
@@ -1318,19 +1318,25 @@ typedef uint64_t uintmax_t;
 #define id_t short
 
 /* Define to `int' if <sys/types.h> does not define. */
+#ifndef __MINGW32__
 #define mode_t unsigned short
+#endif
 
 /* Define to `long long' if <sys/types.h> does not define. */
 /* #undef off_t */
 
 /* Define to `int' if <sys/types.h> doesn't define. */
+#ifndef __MINGW32__
 #define pid_t int
+#endif
 
 /* Define to `unsigned int' if <sys/types.h> does not define. */
 /* #undef size_t */
 
 /* Define to `int' if <sys/types.h> does not define. */
+#ifndef __MINGW32__
 #define ssize_t int64_t
+#endif
 
 /* Define to `int' if <sys/types.h> doesn't define. */
 #define uid_t short
